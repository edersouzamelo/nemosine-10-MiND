# Development and headless usage only. The Windows app stores API keys in the
# current user's Windows Credential Manager instead of this file.
MIND_PROVIDER=mock
MIND_MODEL=mind-mock-1

# Never commit real values. Uncomment only in a local ignored .env.local file.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
